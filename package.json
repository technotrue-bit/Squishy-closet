    "test": "vitest run"
  },
  "dependencies": {
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@types/three": "^0.182.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vitest": "3.2.4"
  }
}
