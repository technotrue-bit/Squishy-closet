{
  "name": "squishy-closet",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Aurora's World: a cute three.js squishy collecting game for kids on TrueAIGaming.com. Phone first, upright.",
  "scripts": {
    "dev": "vite --port 5183 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --port 5183 --strictPort",
    "test": "vitest run",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "8.6.0",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.6.0",
    "@capacitor/preferences": "8.0.1",
    "qrcode-generator": "2.0.4",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@types/three": "^0.182.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vitest": "3.2.4"
  }
}
